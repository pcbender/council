{
  "timeout_seconds": 900,
  "quota_cooldown_seconds": 3600,
  "members": {
    "codex": {
      "enabled": true,
      "executable": "codex",
      "model": null,
      "extra_args": [],
      "tiers": {
        "fast": { "model": null, "effort": "low" },
        "standard": { "model": null, "effort": "medium" },
        "deep": { "model": null, "effort": "high" }
      },
      "role": "Adversarial code reviewer: correctness, edge cases, concurrency, bugs, security."
    },
    "gemini": {
      "enabled": true,
      "executable": "agy",
      "model": null,
      "extra_args": [],
      "tiers": {
        "fast": { "model": null, "effort": "low" },
        "standard": { "model": null, "effort": "medium" },
        "deep": { "model": null, "effort": "high" }
      },
      "role": "Whole-repo critic: architecture, consistency with the rest of the codebase, what was missed."
    },
    "claude": {
      "enabled": true,
      "executable": "claude",
      "model": null,
      "extra_args": [],
      "tiers": {
        "fast": { "model": "sonnet", "effort": "low" },
        "standard": { "model": "sonnet", "effort": "medium" },
        "deep": { "model": "opus", "effort": "high" }
